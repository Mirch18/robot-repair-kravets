                <ui:Button name="StartButton" text="Почати  ▶" style="font-size: 50px; -unity-font-style: bold; color: rgb(4, 30, 45); background-color: rgb(110, 230, 255); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; padding-top: 12px; padding-bottom: 12px; padding-left: 50px; padding-right: 50px; margin-top: 50px; align-self: flex-start; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
