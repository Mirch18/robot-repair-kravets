    <ui:VisualElement name="Water" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ruby/Environment/RisingWater.png?fileID=21300000&amp;guid=1476f7017ab3bdf48b07cc22fc00f125&amp;type=3#RisingWater&quot;); background-repeat: repeat; background-size: 128px 128px;">
